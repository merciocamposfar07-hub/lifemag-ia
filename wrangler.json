{
  "name": "lifemag-ia-clinico",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-02",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCIENCE_LIBRARY",
        "class_name": "LifeMagScientificStore"
      },
      {
        "name": "INGEST_COORDINATOR",
        "class_name": "LifeMagIngestionCoordinator"
      }
    ]
  },
  "exports": {
    "LifeMagScientificStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "LifeMagIngestionCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
